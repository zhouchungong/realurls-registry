{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.zhouchungong/realurls",
  "title": "Realurls",
  "description": "Which domain officially belongs to which software product or company. Ownership only, never safety.",
  "websiteUrl": "https://api.realurls.org",
  "repository": {
    "url": "https://github.com/zhouchungong/realurls-registry",
    "source": "github",
    "subfolder": "mcp"
  },
  "version": "0.1.4",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@realurls/mcp",
      "version": "0.1.4",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "REALURLS_API",
          "description": "API base URL (default https://api.realurls.org)",
          "isRequired": false,
          "isSecret": false
        }
      ]
    }
  ]
}
